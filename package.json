{
  "name": "isometric-skill",
  "version": "2.0.0",
  "private": true,
  "description": "The /isometric Agent Skill: a style-based isometric line-art renderer, a drawing library and checking scripts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p kit/tsconfig.json",
    "watch": "tsc -p kit/tsconfig.json --watch",
    "test": "npm run build && node --test tests/validation/*.test.mjs",
    "examples": "node examples/build-all.mjs",
    "site": "npm --prefix site run build"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
