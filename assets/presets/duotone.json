      "ink": "#e8e6e0",
      "face": "#2b2b2b",
      "plinth": "#3d4c3e",
      "accent": "#6f8cff"
    }
  },
  "solid": {
    "body": [
      "accent~bg:0.86",
      "accent~bg:0.78",
      "accent~bg:0.68"
    ],
    "face": [
      "accent~bg:0.72",
      "accent~bg:0.64",
      "accent~bg:0.54"
    ],
    "detail": [
      "accent~bg:0.56",
